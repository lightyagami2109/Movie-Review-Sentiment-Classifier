# Copy this file to ".env" (same folder) and fill in the values from your Firebase project.
# Firebase console -> Project settings (gear icon) -> General -> "Your apps" -> Web app -> SDK setup.
# These values are public (every Firebase website ships them), so they are safe in the page.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional. Leave empty to use PROJECT_ID.firebaseapp.com
VITE_FIREBASE_AUTH_DOMAIN=
